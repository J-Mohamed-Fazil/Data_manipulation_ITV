import pandas as pd
import numpy as np


df = pd.read_csv('Retail_Dataset_Modified.csv')
print("Dataset Loaded Successful")


df.head()


print("Data Types:")
print(df.dtypes)


df.info()


df['Quantity_Available'] = pd.to_numeric(
    df['Quantity_Available'],
    errors='coerce'
)


print(df['Quantity_Available'].dtypes)


#Convert Units_Sold to Numeric
df['Units_Sold'] = pd.to_numeric(
    df['Units_Sold'],
    errors='coerce'
)
print(df['Units_Sold'].dtypes)


#Convert Revenue to Numeric
df['Revenue']=pd.to_numeric(
    df['Revenue'],
    errors='coerce'
)
print(df['Revenue'].dtypes)


df['Shipping_Cost'] = pd.to_numeric(
    df['Shipping_Cost'],
    errors='coerce'
)

print(df['Shipping_Cost'].dtypes)


print(df[['Quantity_Available',
          'Units_Sold',
          'Revenue',
          'Shipping_Cost']].dtypes)





print("Missing Values:")
print(df.isnull().sum())


missing_cols = df.isnull().sum()
print( 
    missing_cols[missing_cols>0]
)


# Fill Missing Values in City Using Mode
df['City']=df['City'].fillna(
    df['City'].mode()[0]
)


# Fill Missing Values in Product Name Using Mode
df['Product_Name']=df['Product_Name'].fillna(
    df['Product_Name'].mode()[0]
)


# Fill Missing Values in Quantity Available Using Mean

df['Quantity_Available']=df['Quantity_Available'].fillna(
    df['Quantity_Available'].mean()
    )


# Fill Missing Values in Units Sold Using Mean
df['Units_Sold']=df['Units_Sold'].fillna(
    df['Units_Sold'].mean()
)


#Fill Missing Values in Revenue Using Mean
df['Revenue']=df['Revenue'].fillna(
    df['Revenue'].mean()
)


#Fill Missing Values in Supplier Using Mode


df['Supplier']=df['Supplier'].fillna(
    df['Supplier'].mode()[0]
)


# Fill Missing Values in Customer Satisfaction Using Mean
df['Customer_Satisfaction']=df['Customer_Satisfaction'].fillna(
    df['Customer_Satisfaction'].mean()
)


# Fill Missing Values in Delivery Time Using Mean
df['Delivery_Time']=df['Delivery_Time'].fillna(
    df['Delivery_Time'].mean()
)


# Fill Missing Values in Shipping Cost Using Mean
df['Shipping_Cost']=df['Shipping_Cost'].fillna(
    df['Shipping_Cost'].mean()
)


# Verify Missing Values After Cleaning
print(df.isnull().sum())


# Verify Missing Values After Cleaning
print(df.isnull().sum().sum())





duplicates = df.duplicated().sum()

print("Duplicated Records:",duplicates)


df.duplicated()


# Display Duplicate Count
print(df.duplicated().value_counts())


# Remove Duplicate R
df = df.drop_duplicates()


print(df.shape)


print(df.duplicated().value_counts())


print(
    "Remaining Duplicates:",
    df.duplicated().sum()
)


df.head()



